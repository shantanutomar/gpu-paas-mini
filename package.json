{
  "name": "gpu-paas-mini",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:frontend": "pnpm --filter frontend dev",

    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter frontend test && pnpm --filter backend test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:coverage": "pnpm --filter frontend test:coverage && pnpm --filter backend test:coverage",

    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",

    "clean": "rm -rf node_modules pnpm-lock.yaml",
    "install:clean": "pnpm clean && pnpm install"
  }
}
